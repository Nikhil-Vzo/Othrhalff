# ==========================================
# Othrhalff - Server Environment Template (Express/Node)
# ==========================================
# Copy this file to server/.env and fill in your values.

# Server Settings
PORT=5000
NODE_ENV=development

# Redis (Queue, Rate-limiting, Matchmaking)
REDIS_URL=redis://default:password@host:port

# Supabase Settings
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Agora RTC Credentials
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-app-certificate

# Web Push (VAPID) Credentials
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:othrhalff@gmail.com

# LiveKit Credentials
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Administrative Secret
ADMIN_SECRET_KEY=your-secure-admin-secret-key
