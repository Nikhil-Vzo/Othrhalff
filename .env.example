# ==========================================
# Othrhalff - Root Environment Template
# ==========================================
# Copy this file to .env or configure client/.env.local and server/.env individually.

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend & Backend URLs
NEXT_PUBLIC_CLIENT_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SERVER_URL=http://localhost:5000

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Redis (Matchmaking Queue & In-Memory Store)
REDIS_URL=redis://default:password@host:port

# LiveKit (Real-time Audio / Video / Playground)
NEXT_PUBLIC_LIVEKIT_URL=wss://your-livekit-domain.livekit.cloud
LIVEKIT_URL=wss://your-livekit-domain.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Agora RTC (Voice & Matchmaking)
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-app-certificate

# Web Push Notifications (VAPID)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:othrhalff@gmail.com

# Admin Security Key
ADMIN_SECRET_KEY=your-secure-admin-secret-key

# Google Gemini API
NEXT_PUBLIC_GEMINI_API_KEY=your-gemini-api-key

# Google Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# WebRTC / TURN (Optional)
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# System / Maintenance
NEXT_PUBLIC_MAINTENANCE_MODE=false
