# ==========================================
# Othrhalff - Client Environment Template (Next.js)
# ==========================================
# Copy this file to client/.env.local and fill in your values.

# Supabase Client Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend API URLs
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SERVER_URL=http://localhost:5000

# LiveKit Realtime Audio/Video
NEXT_PUBLIC_LIVEKIT_URL=wss://your-livekit-domain.livekit.cloud
LIVEKIT_URL=wss://your-livekit-domain.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Google Gemini API
NEXT_PUBLIC_GEMINI_API_KEY=your-gemini-api-key

# Google Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Optional WebRTC / TURN Configuration
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# App Control
NEXT_PUBLIC_MAINTENANCE_MODE=false

# Server-side API Route Supabase Key (used in client/app/api/contact/route.ts)
SUPABASE_SERVICE_ROLE_KEY=
